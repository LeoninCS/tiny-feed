# Publish example.com -> http://frontend:80 in the Cloudflare Tunnel dashboard.
# Generate each value separately with: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=replace-with-a-random-root-password
MYSQL_PASSWORD=replace-with-a-different-random-app-password
JWT_SECRET=replace-with-a-random-fixed-jwt-secret

# 验证直连 HTTPS 入口后再设置并重建前端；空值仍使用同源上传。
VITE_UPLOAD_API_BASE=
UPLOAD_SITE_ADDRESS=upload.example.com
UPLOAD_ALLOWED_ORIGIN=https://example.com
